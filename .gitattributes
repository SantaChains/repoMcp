# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declared text
*.go      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.py      text eol=lf
*.ps1     text eol=lf
*.toml    text eol=lf

# Binary
*.exe     binary
*.dll     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary