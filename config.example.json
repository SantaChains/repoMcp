{
  "listen": ":8790",
  "token": "把这里换成一个长随机串，与 MCP 客户端侧 headers.Authorization 一致",
  "dataDir": "./data",
  "syncInterval": "15m",
  "gitTimeout": "3m",
  "maxResponseBytes": 12000,

  "githubToken": "有 issues 读写权限的 PAT；也可用环境变量 REPOMCP_GITHUB_TOKEN",
  "maxIssueCreatesPerHour": 5,
  "repos": [
    {
      "name": "repomcp",
      "desc": "repoMcp 本仓：Go 源码（索引/符号/GitHub Issue/Streamable HTTP MCP）",
      "url": "https://github.com/SantaChains/repoMcp.git",
      "ref": "main",
      "webBase": "https://github.com/SantaChains/repoMcp",
      "exclude": ["data/**", ".history/**", "*.exe", "*.log"],
      "issues": {
        "slug": "SantaChains/repoMcp",
        "write": true,
        "labels": ["bug", "enhancement", "question", "documentation"]
      }
    }
  ]
}
